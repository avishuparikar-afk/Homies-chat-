# ==============================================================================
# PRODUCTION ENVIRONMENT VARIABLES TEMPLATE
# Copy to .env and supply actual production values before deployment.
# NEVER commit .env to version control!
# ==============================================================================

# Server Environment
PORT=5000
NODE_ENV=production

# MongoDB Atlas or Production Database Connection String
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/realtime_chat_app?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@cluster0.example.mongodb.net/realtime_chat_app?retryWrites=true&w=majority

# Primary Frontend Client URL & Allowed CORS Origins (comma-separated for multiple domains)
CLIENT_URL=https://chat.yourdomain.com
ALLOWED_ORIGINS=https://chat.yourdomain.com,https://app.yourdomain.com

# Cryptographically Secure JWT Secret (minimum 32 characters, generate with: openssl rand -base64 32)
JWT_SECRET=replace_this_with_a_random_32_character_cryptographically_secure_secret_key!
JWT_EXPIRES_IN=7d

# Socket.IO Production Tuning (Optional, defaults provided)
SOCKET_PING_TIMEOUT=20000
SOCKET_PING_INTERVAL=25000
SOCKET_MAX_BUFFER_SIZE=10000000
